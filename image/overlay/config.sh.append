
# --- OpenQOS overlay (managed by openqos image build) ---
# The scanner is executed through /usr/local/bin/openqos, which relies on the
# sources copied into /opt/openqos/src by the build.
if [ -f /usr/local/bin/openqos ]; then
    chmod 0755 /usr/local/bin/openqos
fi
install -d -m 0755 /var/lib/openqos
install -d -m 0755 /var/log/openqos
printf 'OpenQOS live environment\nbase=Fedora Linux %s\n' "$(rpm -E %fedora)" \
    > /etc/openqos-release
